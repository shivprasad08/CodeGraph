apiVersion: v1
kind: Secret
metadata:
  name: codegraph-secrets
  namespace: codegraph
type: Opaque
# Replace these placeholders with real base64-encoded values before applying.
# Base64 is encoding, not encryption; use stronger secret management in production.
data:
  GITHUB_TOKEN: "BASE64_TOKEN"
  GROQ_API_KEY: "BASE64_GROQ_KEY"
  MISTRAL_API_KEY: "BASE64_MISTRAL_KEY"
